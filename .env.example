# SOLI AI local server
SOLI_HOST=127.0.0.1
SOLI_PORT=5500
DATABASE_PATH=data/soliai.db
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Strongly recommended for broad, frequently updating meme-market stats.
# Requires a Birdeye plan that includes WebSocket access.
BIRDEYE_API_KEY=
ENABLE_BIRDEYE=true

# New token and migration events work without a key.
# Selected-token trade streams currently require a PumpPortal API key and may be metered.
PUMPPORTAL_API_KEY=
ENABLE_PUMPPORTAL=true

# Expands recent/trending/top-traded discovery.
JUPITER_API_KEY=
ENABLE_JUPITER=true

# Reserved for a future Yellowstone/LaserStream decoder bridge.
HELIUS_API_KEY=

# DEX Screener provides periodic public snapshots and pool verification.
ENABLE_DEXSCREENER=true
DEX_DISCOVERY_SECONDS=30
DEX_ENRICH_SECONDS=5

MAX_MARKET_TOKENS=1500
MAX_STREAM_TOKENS=100
MIN_LIQUIDITY_USD=5000
RISK_CACHE_SECONDS=120
INITIAL_PAPER_CASH=10000

# Change this if you connect an external decoder to POST /api/ingest/event.
INGEST_SECRET=change-me-local-only
